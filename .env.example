DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=UTC

# PostgreSQL for production. If DATABASE_URL is omitted, the app falls back to SQLite for local development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/starbank

# SMTP settings for activation emails and daily summaries.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-real-smtp-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Star Bank <noreply@starbank.app>
SITE_NAME=Star Bank
SITE_URL=http://127.0.0.1:8000
PARENT_PIN_SESSION_TIMEOUT_SECONDS=900

